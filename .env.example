# 로컬 인프라 설정 견본. 쓰려면 이 파일을 .env 로 복사한다 (.env 는 레포에 올라가지 않는다).
# 값을 비워 두면 compose.yaml 의 기본값을 쓴다.
# 여기에는 로컬 개발용 값만 둔다. 실제 운영 비밀값은 절대 넣지 않는다.

# 호스트 포트 (다른 프로젝트와 겹칠 때만 바꾼다)
# 기본 19092
KAFKA_PORT=
# 기본 18123
CLICKHOUSE_HTTP_PORT=
# 기본 19000
CLICKHOUSE_NATIVE_PORT=
# 기본 15432
POSTGRES_PORT=
# collector 를 컨테이너로 띄울 때(--profile collector) 여는 호스트 포트. 기본 4317 (OTLP gRPC) · 8081 (HTTP) · 8091 (관리 : /actuator/**)
COLLECTOR_OTLP_PORT=
COLLECTOR_HTTP_PORT=
COLLECTOR_MANAGEMENT_PORT=
# 적재 처리기를 컨테이너로 띄울 때(--profile ingester) 여는 호스트 포트. 기본 8082 (HTTP) · 8092 (관리 : /actuator/**)
INGESTER_HTTP_PORT=
INGESTER_MANAGEMENT_PORT=
# 적재 처리기가 ClickHouse 적재 실패 때 버티는 시간 (ADR #51). 스프링 Duration 표기 (10m · 90s). 비우면 기본값
# 확실한 일시 장애(ClickHouse 가 닿지 않음 · 디스크 꽉 참 등). 기본 10m : 컨테이너 재시작 · 파드 재배치 · 노드 장애를 견디는 선
INGESTER_RETRY_TRANSIENT_MAX_ELAPSED=
# 분류되지 않은 실패. 기본 1m : 진짜 독성이면 그동안 막히므로 짧게. 그 뒤 raw.dlq 로 간다
INGESTER_RETRY_UNKNOWN_MAX_ELAPSED=
# 수집기 트레이스 샘플링 비율. 로컬 기본 1.0 = 전부 통과 (운영 정본은 1%, ADR #33)
# 샘플링을 시험해 보려면 0.1 · 0.0 처럼 넣는다. 0.0 이어도 카나리 표시가 붙은 것은 통과한다
COLLECTOR_SAMPLING_RATIO=
# 수집기가 헬스체크로 보고 버릴 주소 (쉼표 구분). 기본 /actuator/health
# SERVER 스팬의 url.path 가 이 중 하나와 정확히 같으면 Kafka 로 안 보낸다. CLIENT 는 남는다.
#
# 이 변수만 주석으로 둔다. 다른 변수와 달리 "빈 값" 이 뜻을 가지기 때문이다:
#   주석 그대로        -> 기본값 /actuator/health,/livez,/readyz 로 거른다 (평소 이대로 둔다. 수집기 yml 과 같은 값)
#   아래 줄을 열고 빈 값 -> 필터가 꺼져 헬스체크도 그대로 적재된다 (머지 전후 비교 · 헬스체크 조사용)
#   아래 줄을 열고 값   -> 그 목록으로 거른다 (예: /actuator/health,/healthz)
# 주석을 풀고 빈 값으로 두면 compose 의 ${COLLECTOR_HEALTH_CHECK_PATHS-...} 가 빈 글자를 그대로 넘긴다
#COLLECTOR_HEALTH_CHECK_PATHS=
# 수집기 로그 하한 (#215). 이 등급 미만의 로그 레코드는 Kafka 로 안 보낸다. 기본 INFO (수집기 yml 과 같은 값).
# 헬스체크 거르기와 같은 약속 : 주석 그대로 -> INFO, 열고 빈 값 -> 필터 꺼짐(DEBUG 조사용), 열고 값 -> 그 등급 (예: WARN)
#COLLECTOR_LOG_MIN_LEVEL=

# 에이전트 mTLS (#159 · ADR #64). 수집기가 손님(에이전트) 신분증을 얼마나 요구하나. 기본 none (평문, 지금까지와 같다)
#   none     -> TLS 꺼짐. 쇼핑몰은 http://collector:4317 그대로
#   optional -> TLS 로 받되 신분증은 없어도 받는다. 전환 1단계 : 쇼핑몰 .env 에 MONIMO_OTLP_CERTS_DIR 한 줄을 켜고
#               /actuator/metrics/monimo.collector.otlp.agents?tag=auth:mtls 가 4(쇼핑몰 수)인지 본다.
#               연결 수(connections)가 아니라 에이전트 수(agents)를 본다 : 에이전트 하나가 신호마다 연결을 따로 열어 8 ~ 12 로 흔들린다.
#               평문 에이전트는 이 단계에서도 못 붙는다 (에이전트 재시작 한 번이 반드시 든다)
#   require  -> 신분증 없거나 도장이 다르거나 기간이 지나면 끊는다. 전환 2단계
# 인증서는 compose 가 켤 때 ./certs 에 만든다 (otlp-certs 컨테이너, 멱등). 점검 스크립트도 이 값을 읽어 같은 방식으로 보낸다
COLLECTOR_TLS_CLIENT_AUTH=

# 스레드 덤프 명령 문 토큰 (#122). 기본 local-agent-token · local-internal-token (로컬 전용)
# 에이전트 토큰은 monimo-shop 의 MONIMO_AGENT_TOKEN 과, 내부 토큰은 API 서버의 MONIMO_INTERNAL_TOKEN 과 같아야 한다
MONIMO_AGENT_TOKEN=
MONIMO_INTERNAL_TOKEN=

# 로컬 계정 (기본: 사용자 monimo / 비밀번호 monimo)
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=

# api-server 인증 (bootRun 할 때 같은 이름의 환경변수로 넘긴다. 비우면 application.yml 의 설명대로 동작)
# access JWT 서명 키. 32바이트 이상의 임의 문자열
MONIMO_JWT_SECRET=
# 내부 문(/api/v1/internal/**) 공유 비밀값. 탐지 · 파수꾼이 같은 값을 X-Internal-Token 으로 보낸다
MONIMO_INTERNAL_TOKEN=
# 스레드 덤프 팬아웃 대상 수집기 주소들(쉼표). 비우면 http://localhost:8081 한 대
MONIMO_COLLECTOR_URLS=

# detector 스케줄 평가 (bootRun 할 때 같은 이름의 환경변수로 넘긴다. 내부 토큰은 위 MONIMO_INTERNAL_TOKEN 과 같은 값)
# service-health 를 여는 API 서버 주소. 기본 http://localhost:8080
MONIMO_API_SERVER_URL=
